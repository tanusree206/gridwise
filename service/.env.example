# GridWise FastAPI service — copy to `.env` and adjust as needed.
# After editing, restart `uvicorn` so the new values are picked up.

# Where the service listens. Default: 0.0.0.0:8000
GRIDWISE_HOST=0.0.0.0
GRIDWISE_PORT=8000

# CORS allow-list. Use a comma-separated list of origins or `*` for any.
# Example: http://localhost:3000,https://gridwise.example.com
GRIDWISE_ALLOWED_ORIGINS=*

# Where the Python client (api_client.py) targets by default.
# Override at runtime with:  GRIDWISE_API_BASE=https://api.example.com gw.analyze()
GRIDWISE_API_BASE=http://localhost:8000
